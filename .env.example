# Copy to .env and fill in. Never commit .env.
MONGO_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=5000
# Optional: override if AMFI moves the NAV file
# AMFI_NAV_URL=https://www.amfiindia.com/spages/NAVAll.txt
# 32-byte hex key that encrypts 2FA secrets at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing/losing it locks out every 2FA user. Only the 2FA routes need it.
TWO_FACTOR_ENC_KEY=

# Gmail account that sends signup verification codes, with a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords). Not your normal password.
SMTP_USER=
SMTP_PASS=

# Allowed browser origin(s), comma-separated, no trailing slash. Prod: your Vercel URL.
# Unset = only http://localhost:5173 and :5174.
FRONTEND_URL=http://localhost:5173
